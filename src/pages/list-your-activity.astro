---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';
import { TOWNS, CATEGORIES } from '../data/taxonomy';
const action = SITE.forms.listingAction;
---
<Base title="List or claim your kids' activity for free" description="Add your children's class, club or holiday camp in West Herts to the directory for free, or claim your existing listing to update it.">
  <div class="container" style="padding-bottom:96px">
  <ol class="crumbs" aria-label="Breadcrumb"><li><a href="/">Home</a></li><li aria-hidden="true">/</li><li aria-current="page">List your activity</li></ol>
  <header class="page-head" style="margin-bottom:32px">
    <p class="plate">For providers</p>
    <h1>Run a class? <em>Listing is free.</em></h1>
    <p class="lead">Fill this in to add a new activity, or to claim and update an existing listing. We check every submission against your own website before it goes live.</p>
  </header>
  <p class="notice" id="list-error" data-email={SITE.email} role="alert" hidden style="color:var(--ink)"></p>
  <form class="form" action={action} method="post">
    <input type="hidden" name="claim" id="claim" />
    <div class="nl-hp" aria-hidden="true"><label>Leave this empty<input name="fax_number" tabindex="-1" autocomplete="off" /></label></div>
    <label>Your name<input name="contact_name" required autocomplete="name" /></label>
    <label>Email<input name="contact_email" type="email" required autocomplete="email" /></label>
    <label>Business or activity name<input name="business" required /></label>
    <label>Website<input name="website" type="url" placeholder="https://" /></label>
    <label>Activity type
      <select name="category">{Object.entries(CATEGORIES).map(([k, c]) => <option value={c.name}>{c.name}</option>)}</select>
    </label>
    <label>Main town
      <select name="town">{Object.entries(TOWNS).map(([k, t]) => <option value={t.name}>{t.name}</option>)}</select>
    </label>
    <label>Ages, days, times and prices<textarea name="details" rows="5" placeholder="e.g. Ages 4–7, Saturdays 9:30–10:15 at Croxley Community Centre, £9 per session, free trial"></textarea></label>
    <label class="consent"><input type="checkbox" name="consent" required /> I confirm I'm authorised to list this business, and I'm happy for West Herts Kids to email me about this listing.</label>
    <button class="btn" type="submit">Send</button>
  </form>
  {SITE.mode !== 'community' && <p class="small muted">Want more visibility? See <a href="/advertise/">featured listings</a>.</p>}

  <section class="badge-box" aria-labelledby="badge-title">
    <h2 id="badge-title">Already listed? Add our free badge</h2>
    <p>If you'd like to, pop this badge on your own website so parents can see your listing. It's entirely optional and always free.</p>
    <p><img src="/badge.svg" width="200" height="56" alt="Listed on West Herts Kids" /></p>
    <label for="badge-code">Copy this code into your website (replace <code>your-listing</code> with the end of your listing's web address):</label>
    <textarea id="badge-code" class="badge-code" rows="3" readonly>{`<a href="${SITE.url}/activities/your-listing/"><img src="${SITE.url}/badge.svg" width="200" height="56" alt="Listed on West Herts Kids"></a>`}</textarea>
  </section>
  <script>
    const q = new URLSearchParams(location.search);
    const c = q.get('claim');
    const el = document.getElementById('claim') as HTMLInputElement | null;
    if (c && el) el.value = c;
    const box = document.getElementById('list-error');
    const email = box?.dataset.email ?? '';
    const text: Record<string, string> = {
      invalid: 'Please fill in your name, a valid email address and the activity name, and tick the box.',
      unavailable: `The form isn't switched on yet. Please email the details to ${email} instead.`,
      failed: `Something went wrong sending the form. Please try again, or email the details to ${email}.`,
    };
    const code = q.get('error');
    if (code && box && text[code]) { box.textContent = text[code]; box.hidden = false; box.scrollIntoView({ block: 'center' }); }
  </script>
  </div>
</Base>
