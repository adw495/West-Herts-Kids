---
import Base from '../layouts/Base.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
---
<Base title="Free weekly 'What's on for kids' email" description="A short weekly email of what's on for children in West Herts: events, holiday camps and new classes. Free, unsubscribe any time.">
  <p class="breadcrumb"><a href="/">Home</a> › Newsletter</p>
  <h1>What's on for kids, every Thursday</h1>
  <p class="muted">A short email of this weekend's events, upcoming holiday camps and new classes near you, across Watford, Rickmansworth, Croxley Green, Chorleywood and Abbots Langley.</p>
  <p class="notice" id="nl-error" hidden></p>
  <NewsletterForm source="newsletter-page" />
  <script>
    // Shown when a no-JavaScript form post comes back with an error.
    const code = new URLSearchParams(location.search).get('error');
    const box = document.getElementById('nl-error');
    const text: Record<string, string> = {
      invalid: 'That email address does not look right. Please try again.',
      unavailable: 'Sign-ups are not switched on yet. Please try again soon.',
      failed: 'Something went wrong. Please try again in a minute.',
    };
    if (code && box && text[code]) { box.textContent = text[code]; box.hidden = false; }
  </script>
</Base>
