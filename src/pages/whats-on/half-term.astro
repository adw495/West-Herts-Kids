---
// Stable half-term page: always shows the next (or current) Herts half term, so links and search ranking
// build up on one URL instead of restarting each holiday (Google's advice for recurring events).
// Dates come from src/data/term-dates.ts; dated guides from SEASONAL_GUIDES. Rebuilt on every deploy, and
// the small script below hides a half term that has ended in between deploys.
import Base from '../../layouts/Base.astro';
import CompareTable from '../../components/CompareTable.astro';
import { getListings, getPosts, byCategory, faqLd, breadcrumbLd } from '../../lib/listings';
import { HOLIDAYS, TERM_DATES_SOURCE, SEASONAL_GUIDES } from '../../data/term-dates';
import { SITE } from '../../site.config';

const all = await getListings();
const posts = await getPosts();
const postIds = new Set(posts.map((p) => p.id));
const today = new Date().toISOString().slice(0, 10);
const halfTerms = HOLIDAYS.filter((h) => h.id.includes('half-term') && h.end >= today).slice(0, 2);
const next = halfTerms[0];

const addDays = (iso: string, n: number) => { const d = new Date(`${iso}T12:00:00Z`); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); };
const fmt = (iso: string, opts: Intl.DateTimeFormatOptions = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-GB', { timeZone: 'UTC', ...opts });
const short = (h: { start: string; end: string }) => `${fmt(h.start, { day: 'numeric' })}–${fmt(h.end, { day: 'numeric', month: 'short' })}`;
const year = (iso: string) => iso.slice(0, 4);
// Herts half terms run Monday to Friday, so school finishes the Friday before and restarts the Monday after.
const lastDay = (h: { start: string }) => addDays(h.start, -3);
const backDay = (h: { end: string }) => addDays(h.end, 3);
const guidesFor = (id: string) => (SEASONAL_GUIDES[id] ?? []).filter((g) => postIds.has(g.href));

const always = [
  { href: 'holiday-camps-watford', label: 'Holiday camps and clubs in Watford' },
  { href: 'indoor-rainy-day-kids-watford', label: 'Indoor and rainy-day ideas' },
  { href: 'free-things-to-do-kids-watford', label: 'Free things to do with kids' },
  { href: 'playgrounds-parks-watford-rickmansworth', label: 'Playgrounds and parks' },
  { href: 'soft-play-watford', label: 'Soft play compared' },
  { href: 'farms-animal-days-out-watford', label: 'Farms and animal days out' },
].filter((g) => postIds.has(g.href));
const camps = byCategory(all, 'holiday-camps').sort((a, b) => a.data.name.localeCompare(b.data.name));

const title = next ? `Half term in Watford: ${next.name.replace(' half term', '')} ${year(next.start)} (${short(next)})` : 'Half term in Watford & West Herts';
const description = next
  ? `${next.name} ${year(next.start)} in Hertfordshire is ${fmt(next.start, { day: 'numeric', month: 'long' })} to ${fmt(next.end, { day: 'numeric', month: 'long' })}. Holiday camps, events and days out for kids in Watford, Rickmansworth and West Herts.`
  : 'Half term dates, holiday camps, events and days out for kids in Watford, Rickmansworth and West Herts.';

const faq = next ? [
  { q: `When is ${next.name.toLowerCase()} ${year(next.start)} in Hertfordshire?`, a: `${fmt(next.start)} to ${fmt(next.end)}, according to Hertfordshire County Council. The last school day before it is ${fmt(lastDay(next), { weekday: 'long', day: 'numeric', month: 'long' })} and children go back on ${fmt(backDay(next), { weekday: 'long', day: 'numeric', month: 'long' })}. Academies, free schools and independent schools can set their own dates.` },
  ...(halfTerms[1] ? [{ q: `When is the half term after that?`, a: `${halfTerms[1].name} ${year(halfTerms[1].start)}: ${fmt(halfTerms[1].start)} to ${fmt(halfTerms[1].end)}.` }] : []),
  { q: 'Which holiday camps run near Watford at half term?', a: `We list ${camps.length} local holiday camps and clubs, with ages and prices from each provider's own website. Not every camp runs every half term, so check its dates before booking.` },
] : [];

const ld = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: `${SITE.url}/whats-on/half-term/` },
  ...(faq.length ? [faqLd(faq)] : []),
  breadcrumbLd([['Home', '/'], ["What's on", '/whats-on/'], ['Half term', '/whats-on/half-term/']]),
];
---
<Base title={title} description={description} jsonLd={ld}>
  <div class="container">
    <ol class="crumbs" aria-label="Breadcrumb"><li><a href="/">Home</a></li><li aria-hidden="true">/</li><li><a href="/whats-on/">What’s on</a></li><li aria-hidden="true">/</li><li aria-current="page">Half term</li></ol>
    <header class="page-head">
      <p class="plate">Half term</p>
      <h1>Half term in <em>Watford &amp; West Herts</em></h1>
      <p class="lead">The next Hertfordshire half term, what’s on locally and the holiday camps running nearby. Every date comes from Hertfordshire County Council, and every camp and event from the organiser’s own website.</p>
    </header>

    {halfTerms.map((h, i) => (
      <section class="planner-next" aria-labelledby={`ht-${h.id}`} data-end={h.end} hidden={i > 0} data-fallback={i > 0 ? 'true' : undefined} style="margin-top:24px">
        <p class="kicker" style="margin-top:0" data-start={h.start}>{h.start > today ? 'Next up' : 'On now'}</p>
        <h2 id={`ht-${h.id}`}>{h.name} {year(h.start)}</h2>
        <p class="lead" style="margin-top:8px">{fmt(h.start)} to {fmt(h.end)}</p>
        <p>Last day of school: <strong>{fmt(lastDay(h), { weekday: 'long', day: 'numeric', month: 'long' })}</strong>. Back to school: <strong>{fmt(backDay(h), { weekday: 'long', day: 'numeric', month: 'long' })}</strong>.</p>
        {guidesFor(h.id).length > 0
          ? <ul class="planner-links">{guidesFor(h.id).map((g) => <li><a href={`/whats-on/${g.href}/`}>{g.label}</a></li>)}</ul>
          : <p class="small muted">Our {h.name.toLowerCase()} {year(h.start)} guide is on its way; we add camps and events as organisers publish them. Until then, the guides below cover any holiday.</p>}
      </section>
    ))}
    <p class="small muted" style="margin-top:8px">Hertfordshire County Council dates (<a href={TERM_DATES_SOURCE} rel="noopener" target="_blank">source</a>). Every school adds its own INSET days, so check your school’s calendar. See <a href="/whats-on/school-holiday-planner/">every school holiday</a> or the <a href="/whats-on/herts-school-term-dates-2026-27/">full term dates</a>.</p>

    <section aria-labelledby="more-title" style="margin-top:48px">
      <h2 id="more-title">Ideas for any half term</h2>
      <ul class="planner-links">{always.map((g) => <li><a href={`/whats-on/${g.href}/`}>{g.label}</a></li>)}</ul>
    </section>

    <div style="margin-top:56px">
      <CompareTable items={camps} heading="Holiday camps and clubs near Watford" id="camps-title" showTown />
    </div>

    <script is:inline>
      // Between deploys: once a half term has ended, hide it and show the next one.
      (function () {
        var t = new Date(); var today = t.getFullYear() + '-' + String(t.getMonth() + 1).padStart(2, '0') + '-' + String(t.getDate()).padStart(2, '0');
        var shown = false;
        document.querySelectorAll('section[data-end]').forEach(function (el) {
          if (el.getAttribute('data-end') < today || shown) { el.hidden = true; return; }
          el.hidden = false; shown = true;
          var k = el.querySelector('[data-start]');
          if (k && k.getAttribute('data-start') <= today) k.textContent = 'On now';
        });
      })();
    </script>

    {faq.length > 0 && (
      <section class="faq" aria-labelledby="faq-title" style="margin:48px 0 96px">
        <h2 id="faq-title">Questions parents ask</h2>
        {faq.map((x) => (<details><summary>{x.q}</summary><p>{x.a}</p></details>))}
      </section>
    )}
  </div>
</Base>
