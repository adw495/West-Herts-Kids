---
// Stable "this weekend" page: always shows the newest weekly round-up, so links and search ranking
// build up on one URL instead of restarting with each dated post. The dated posts stay as an archive.
import Base from '../../layouts/Base.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { render } from 'astro:content';
import { getPosts, formatDate } from '../../lib/listings';
import { SITE } from '../../site.config';

const posts = await getPosts();
const weekly = posts.filter((p) => p.data.type === 'whats-on' && /^\d{4}-\d{2}-\d{2}-whats-on$/.test(p.id));
const latest = weekly[0];
const { Content } = latest ? await render(latest) : { Content: null };
const guides = posts.filter((p) => p.data.type !== 'whats-on' || !/^\d{4}-\d{2}-\d{2}-whats-on$/.test(p.id)).slice(0, 6);
const ageDays = latest ? (Date.now() - latest.data.date.getTime()) / 86400000 : 999;
const title = 'What’s on for kids this weekend in Watford & West Herts';
const description = latest
  ? `This week’s picks for kids and families in Watford, Rickmansworth, Croxley Green, Chorleywood and nearby: ${latest.data.description}`.slice(0, 200)
  : 'Weekly picks of what’s on for kids and families in Watford, Rickmansworth, Croxley Green and Chorleywood.';
const ld = latest && {
  '@context': 'https://schema.org', '@type': 'Article', headline: title, description,
  datePublished: latest.data.date.toISOString(), dateModified: (latest.data.updated ?? latest.data.date).toISOString(),
  author: { '@type': 'Organization', name: SITE.name, url: SITE.url }, publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  mainEntityOfPage: `${SITE.url}/whats-on/this-weekend/`,
};
---
<Base title={title} description={description} jsonLd={ld}>
  <div class="container">
    <ol class="crumbs" aria-label="Breadcrumb"><li><a href="/">Home</a></li><li aria-hidden="true">/</li><li><a href="/whats-on/">What’s on</a></li><li aria-hidden="true">/</li><li aria-current="page">This weekend</li></ol>
    <article style="padding:16px 0 64px">
      <p class="kicker" style="margin-top:0">What’s on · By {SITE.name}{latest && <> · Updated <time datetime={latest.data.date.toISOString().slice(0, 10)}>{formatDate(latest.data.date)}</time></>}</p>
      <h1 style="max-width:18em">What’s on for kids <em>this weekend</em></h1>
      {latest && <p class="lead" style="margin-top:16px">{latest.data.title.replace(/^What's on for kids in West Herts: /, 'Our picks for ')}. Every event is checked against the organiser’s own website.</p>}
      {ageDays > 8 && <p class="notice" role="note">This week’s round-up is on its way. Until then, here are the latest picks we checked, plus our guides below.</p>}
      {Content && <div class="prose" style="margin-top:32px"><Content /></div>}
      <p class="follow-note">Want this every week? Get it free by email below.</p>
    </article>
    <section style="padding-bottom:88px">
      <p class="plate">More ideas</p>
      <h2 style="margin-bottom:24px">Guides for <em>any weekend</em></h2>
      <ul>{guides.map((g) => <li><a href={`/whats-on/${g.id}/`}>{g.data.title}</a></li>)}</ul>
      <p><a href="/whats-on/">All round-ups and guides</a></p>
    </section>
  </div>
  <section class="news on-dark" aria-labelledby="news-title">
    <div class="container">
      <div style="max-width:720px">
        <p class="eyebrow">The newsletter</p>
        <h2 id="news-title">Get this in <em>your inbox</em></h2>
        <p class="lead" style="margin:18px 0 26px">The free “What’s on for kids” email, most Thursdays in term time.</p>
        <NewsletterForm source="this-weekend" />
        <p class="fine">Unsubscribe any time. See our <a href="/privacy/">privacy notice</a>.</p>
      </div>
    </div>
  </section>
</Base>
