---
import Base from '../../layouts/Base.astro';
import ListingCard from '../../components/ListingCard.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import Postmark from '../../components/art/Postmark.astro';
import CompareTable from '../../components/CompareTable.astro';
import { render } from 'astro:content';
import { getPosts, getListings, formatDate, type Post } from '../../lib/listings';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
interface Props { post: Post }
const { post } = Astro.props;
const { Content } = await render(post);
const listings = await getListings();
const related = listings.filter((l) => post.data.related.includes(l.id));
// The newest weekly round-up is also shown at the stable /whats-on/this-weekend/ URL, which collects the links.
const latestWeekly = (await getPosts()).find((p) => p.data.type === 'whats-on' && /^\d{4}-\d{2}-\d{2}-whats-on$/.test(p.id));
const canonical = latestWeekly?.id === post.id ? '/whats-on/this-weekend/' : undefined;
const typeLabel: Record<string, string> = { 'whats-on': 'What’s on', guide: 'Guide', comparison: 'Comparison', news: 'News' };
const ld = {
  '@context': 'https://schema.org', '@type': 'Article', headline: post.data.title, description: post.data.description,
  datePublished: post.data.date.toISOString(), dateModified: (post.data.updated ?? post.data.date).toISOString(),
  author: { '@type': 'Organization', name: SITE.name, url: SITE.url }, publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  mainEntityOfPage: `${SITE.url}/whats-on/${post.id}/`,
};
---
<Base title={post.data.title} description={post.data.description} jsonLd={ld} canonical={canonical}>
  <div class="container">
    <ol class="crumbs" aria-label="Breadcrumb"><li><a href="/">Home</a></li><li aria-hidden="true">/</li><li><a href="/whats-on/">What’s on</a></li><li aria-hidden="true">/</li><li aria-current="page">{typeLabel[post.data.type]}</li></ol>
    <article style="padding:16px 0 64px">
      <p class="kicker" style="margin-top:0">{typeLabel[post.data.type]} · By {SITE.name} · {post.data.updated ? <>Updated <time datetime={post.data.updated.toISOString().slice(0, 10)}>{formatDate(post.data.updated)}</time></> : <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>}</p>
      <h1 style="max-width:18em">{post.data.title}</h1>
      <p class="lead" style="margin-top:16px">{post.data.description}</p>
      <div class="prose" style="margin-top:32px"><Content /></div>
      {related.length >= 3 && post.data.type !== 'whats-on' && <CompareTable items={related} heading="Our listings side by side" id="guide-compare" showTown />}
      <p class="follow-note">Like this? <a href={SITE.facebook} rel="noopener">Follow West Herts Kids on Facebook</a> for weekend picks and new guides, or get them by email below.</p>
    </article>
    {related.length > 0 && (
      <section style="padding-bottom:88px">
        <p class="plate">In this article</p>
        <h2 style="margin-bottom:32px">The <em>activities</em></h2>
        <div class="cards">{related.map((l, i) => <ListingCard listing={l} index={i} />)}</div>
      </section>
    )}
  </div>
  <section class="news on-dark" aria-labelledby="news-title">
    <div class="container">
      <Postmark />
      <div style="max-width:720px">
        <p class="eyebrow">The newsletter</p>
        <h2 id="news-title">Get this in <em>your inbox</em></h2>
        <p class="lead" style="margin:18px 0 26px">The free “What’s on for kids” email, most Thursdays in term time.</p>
        <NewsletterForm source="article-band" />
        <p class="fine">Unsubscribe any time. See our <a href="/privacy/">privacy notice</a>.</p>
      </div>
    </div>
  </section>
</Base>
