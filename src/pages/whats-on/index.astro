---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/listings';
const posts = await getPosts();
const typeLabel: Record<string, string> = { 'whats-on': 'What’s on', guide: 'Guide', comparison: 'Comparison', news: 'News' };
---
<Base title="What's on for kids in West Herts" description="Weekly round-ups of what's on for children in Watford, Rickmansworth, Croxley Green and Chorleywood, plus local guides.">
  <div class="container">
    <ol class="crumbs" aria-label="Breadcrumb"><li><a href="/">Home</a></li><li aria-hidden="true">/</li><li aria-current="page">What’s on</li></ol>
    <header class="page-head">
      <p class="plate">From the notebook</p>
      <h1>What’s on <em>&amp; guides</em></h1>
      <p class="lead">Round-ups of kids’ events and holiday camps, plus plain-English guides to choosing classes locally.</p>
    </header>
    <div class="post-list" style="margin:40px 0 96px">
      {posts.map((p) => (
        <article class="side-card">
          <p class="kicker" style="margin-top:0">{typeLabel[p.data.type]} · {formatDate(p.data.date)}</p>
          <h2 class="side-title" style="font-size:26px"><a href={`/whats-on/${p.id}/`}>{p.data.title}</a></h2>
          <p class="muted" style="margin:12px 0 0;font-size:16px">{p.data.description}</p>
          <a class="btn link" href={`/whats-on/${p.id}/`}>Read <span aria-hidden="true">→</span></a>
        </article>
      ))}
      {posts.length === 0 && <p class="empty">The first round-up is coming soon.</p>}
    </div>
  </div>
</Base>
