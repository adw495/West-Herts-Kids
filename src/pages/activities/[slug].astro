---
import Base from '../../layouts/Base.astro';
import ListingCard from '../../components/ListingCard.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import Stamp from '../../components/Stamp.astro';
import Wave from '../../components/art/Wave.astro';
import SendIcon from '../../components/art/SendIcon.astro';
import { render } from 'astro:content';
import { getListings, getPosts, ageLabel, ageShort, priceLabel, priceFact, whenLabel, dayName, formatDate, listingJsonLd, isFeaturedNow, byTown, type Listing } from '../../lib/listings';
import { TOWNS, CATEGORIES } from '../../data/taxonomy';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  const listings = await getListings();
  return listings.map((listing) => ({ params: { slug: listing.id }, props: { listing, all: listings } }));
}
interface Props { listing: Listing; all: Listing[] }
const { listing, all } = Astro.props;
const d = listing.data;
const { Content } = await render(listing);
const mainCat = d.categories[0];
const mainTown = d.towns[0];
const price = priceFact(d);
const similar = all
  .filter((l) => l.id !== listing.id && l.data.categories.some((c) => d.categories.includes(c)))
  .sort((a, b) => Number(b.data.towns.some((t) => d.towns.includes(t))) - Number(a.data.towns.some((t) => d.towns.includes(t))))
  .slice(0, 3);
const posts = (await getPosts()).filter((p) => p.data.related.includes(listing.id)).slice(0, 3);
const seasonText: Record<string, string> = { 'term-time': 'Term time', holidays: 'School holidays', 'year-round': 'All year' };
const when = d.season.map((s) => seasonText[s]).join(', ');
const domain = d.website ? new URL(d.website).hostname.replace(/^www\./, '') : null;
const addr = [d.venue.name, d.venue.address, d.venue.postcode].filter(Boolean).join(', ');
const osmQuery = d.venue.postcode || (d.venue.address ? `${d.venue.address}` : null);
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: CATEGORIES[mainCat].name, item: `${SITE.url}/category/${mainCat}/` },
    { '@type': 'ListItem', position: 3, name: d.name },
  ],
};
const title = `${d.name}: ${CATEGORIES[mainCat].name.toLowerCase()} in ${TOWNS[mainTown].name}`;
const townCount = (t: keyof typeof TOWNS) => byTown(all, t).length;
---
<Base title={title} description={d.summary} jsonLd={[listingJsonLd(listing), breadcrumbLd]}>
  <div class="container">
    <ol class="crumbs" aria-label="Breadcrumb">
      <li><a href="/">Home</a></li><li aria-hidden="true">/</li>
      <li><a href="/activities/">All activities</a></li><li aria-hidden="true">/</li>
      <li><a href={`/category/${mainCat}/`}>{CATEGORIES[mainCat].name}</a></li><li aria-hidden="true">/</li>
      <li><a href={`/towns/${mainTown}/`}>{TOWNS[mainTown].name}</a></li><li aria-hidden="true">/</li>
      <li aria-current="page">{d.name}</li>
    </ol>
  </div>

  <section class="lhead">
    <div class="container">
      <div>
        <p class="eyebrow">{isFeaturedNow(listing) && <span style="color:var(--brick)">Featured · </span>}{d.categories.map((c) => CATEGORIES[c].name).join(' · ')} — {d.towns.map((t) => TOWNS[t].name).join(', ')}</p>
        <h1>{d.name}</h1>
        <p class="lead">{d.summary}</p>
        <dl class="keyfacts" aria-label="Key facts">
          <div><dt>Ages</dt><dd><span class="fig">{ageShort(d.ageMin, d.ageMax)}</span><span class="fsub">{ageLabel(d.ageMin, d.ageMax)}</span></dd></div>
          <div><dt>{price?.label ?? 'Price'}</dt><dd><span class="fig">{price?.value ?? 'Ask'}</span><span class="fsub">{price?.sub ?? 'see provider website'}</span></dd></div>
          <div><dt>When</dt><dd><span class="fig" style="font-size:20px">{whenLabel(d)}</span><span class="fsub">{when}</span></dd></div>
          <div><dt>SEND</dt><dd><span class="fig">{d.send === 'yes' ? 'Yes' : d.send === 'no' ? 'Not stated' : 'Ask'}</span><span class="fsub">{d.send === 'yes' ? 'Dedicated support' : 'Check with the provider'}</span></dd></div>
        </dl>
        <div class="btn-row">
          {d.bookingUrl && <a class="btn brick" href={d.bookingUrl} rel="nofollow noopener" target="_blank">Book now <span aria-hidden="true">↗</span></a>}
          {d.website && <a class="btn" href={d.website} rel="noopener" target="_blank">Visit their website <span aria-hidden="true">↗</span></a>}
          {osmQuery && <a class="btn ghost" href={`https://www.openstreetmap.org/search?query=${encodeURIComponent(osmQuery)}`} rel="noopener" target="_blank">Find on a map</a>}
          {domain && <span class="ldomain">{domain}</span>}
        </div>
      </div>
      <div class="lhead-art" aria-hidden="true"><span class="blob"></span><CategoryIcon cat={mainCat} class="cat" /></div>
    </div>
  </section>

  <section class="lbody band-paper2">
    <Wave fill="#F6F1E6" />
    <div class="container">
      <div>
        <h2 style="font-size:2.2rem">About</h2>
        <div class="prose" style="margin-top:12px"><Content /></div>

        {d.schedule.length > 0 && (
          <>
            <h2 style="font-size:1.9rem;margin-top:40px">Timetable</h2>
            <table class="timetable">
              <thead><tr><th scope="col">Day</th><th scope="col">Time</th><th scope="col">Notes</th></tr></thead>
              <tbody>{d.schedule.map((s) => <tr><td>{dayName(s.day)}</td><td>{s.start}{s.end && `–${s.end}`}</td><td>{s.note}</td></tr>)}</tbody>
            </table>
          </>
        )}

        {d.send !== 'unknown' && (
          <div class="send-box">
            <SendIcon />
            <h2>SEND and accessibility {d.send === 'yes' && <span class="yes-tag">Yes</span>}</h2>
            <p style="margin:0">{d.send === 'yes' ? 'This provider says it welcomes children with special educational needs and disabilities.' : 'This provider hasn’t said it offers specific SEND support.'} {d.sendNotes}</p>
            <p class="muted small" style="margin:10px 0 0">Not sure a session will suit your child? It’s worth a quick message to the provider before you book.</p>
          </div>
        )}

        {(addr || d.phone || d.email) && (
          <div class="where">
            <h2 style="font-size:1.9rem">Where to find it</h2>
            <div class="where-card">
              {addr && <address>{addr}</address>}
              {!addr && <p style="margin:0">{d.towns.map((t) => TOWNS[t].name).join(', ')}</p>}
              <p class="small" style="margin:10px 0 0">
                {d.phone && <>Phone: <a href={`tel:${d.phone.replace(/\s/g, '')}`}>{d.phone}</a><br /></>}
                {d.email && <>Email: <a href={`mailto:${d.email}`}>{d.email}</a><br /></>}
                {osmQuery && <a href={`https://www.openstreetmap.org/search?query=${encodeURIComponent(osmQuery)}`} rel="noopener" target="_blank">Open in OpenStreetMap</a>}
              </p>
            </div>
          </div>
        )}

        {posts.length > 0 && (
          <div class="where">
            <h2 style="font-size:1.9rem">Mentioned in</h2>
            <ul>{posts.map((p) => <li><a href={`/whats-on/${p.id}/`}>{p.data.title}</a></li>)}</ul>
          </div>
        )}
      </div>

      <aside class="aside-stack" aria-label="At a glance">
        <div class="facts-card">
          <p class="plate">Field notes</p>
          <h2>At a glance</h2>
          <dl>
            <div><dt>Ages</dt><dd>{ageLabel(d.ageMin, d.ageMax)}</dd></div>
            <div><dt>Price</dt><dd>{priceLabel(d) ?? 'Not published: ask the provider'}{d.priceNote && <span class="fsub">{d.priceNote}</span>}</dd></div>
            {d.freeTrial && <div><dt>Trial</dt><dd>Free taster available</dd></div>}
            <div><dt>When</dt><dd>{whenLabel(d)}<span class="fsub">{when}</span></dd></div>
            <div><dt>Where</dt><dd>{addr || d.towns.map((t) => TOWNS[t].name).join(', ')}</dd></div>
            <div><dt>SEND</dt><dd>{d.send === 'yes' ? 'Yes' : d.send === 'no' ? 'Not stated' : 'Not stated: ask the provider'}</dd></div>
          </dl>
          <div class="perf" aria-hidden="true"><span></span><span></span></div>
          {d.website && <a class="btn" href={d.website} rel="noopener" target="_blank">Visit their website <span aria-hidden="true">↗</span></a>}
          {d.verified && <Stamp date={d.verified} size={112} tilt={-8} class="stamp-lg" />}
        </div>

        <section class="on-line" aria-labelledby="otl">
          <p class="plate" style="margin-bottom:2px">On the line</p>
          <h2 id="otl">{d.towns.length === 1 ? `One stop: ${TOWNS[mainTown].name}` : `${d.towns.length} stops`}</h2>
          <ul>
            {d.towns.map((t) => (
              <li><a href={`/towns/${t}/`}><span class="dot" aria-hidden="true"><i></i></span>{TOWNS[t].name}<small>{townCount(t)} listings</small></a></li>
            ))}
          </ul>
        </section>

        <div class="claim-note">
          {!d.claimed && <p style="margin:0 0 8px">{d.verified ? `Details last checked on ${formatDate(d.verified)} from public information.` : 'These details come from public information and haven’t been confirmed by the provider yet.'} Is this your business? <a href={`/list-your-activity/?claim=${listing.id}`}>Claim this listing</a> to update it for free.</p>}
          <p style="margin:0">Spotted something out of date? <a href={`/list-your-activity/?claim=${listing.id}`}>Let us know</a>.</p>
        </div>
      </aside>
    </div>
  </section>

  {similar.length > 0 && (
    <section class="section" aria-labelledby="similar-title" style="padding-top:88px;padding-bottom:104px">
      <div class="container">
        <div class="sec-head">
          <div>
            <p class="plate">Same family, different branch</p>
            <h2 id="similar-title">Similar <em>nearby</em></h2>
          </div>
          <a class="btn ghost" href={`/category/${mainCat}/`}>All {CATEGORIES[mainCat].name.toLowerCase()} <span aria-hidden="true">→</span></a>
        </div>
        <div class="cards">{similar.map((l, i) => <ListingCard listing={l} index={i} />)}</div>
      </div>
    </section>
  )}
</Base>
