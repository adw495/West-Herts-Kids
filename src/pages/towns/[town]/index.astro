---
import Base from '../../../layouts/Base.astro';
import ListingCard from '../../../components/ListingCard.astro';
import Filters from '../../../components/Filters.astro';
import { getListings, byTown, byCategory, MIN_FOR_COMBO_PAGE, MIN_TO_INDEX_TOWN, breadcrumbLd, itemListLd, type Listing } from '../../../lib/listings';
import { TOWNS, CATEGORIES, type TownKey, type CategoryKey } from '../../../data/taxonomy';

export async function getStaticPaths() {
  const listings = await getListings();
  return (Object.keys(TOWNS) as TownKey[])
    .map((town) => ({ params: { town }, props: { town, items: byTown(listings, town) } }))
    .filter((p) => p.props.items.length > 0);
}
interface Props { town: TownKey; items: Listing[] }
const { town, items } = Astro.props;
const t = TOWNS[town];
const jsonLd = [
  itemListLd(`Kids' activities in ${t.name}`, items),
  breadcrumbLd([['Home', '/'], ['Towns', '/towns/'], [t.name, `/towns/${town}/`]]),
];
const catLinks = (Object.keys(CATEGORIES) as CategoryKey[]).filter((c) => byCategory(items, c).length >= MIN_FOR_COMBO_PAGE);
---
<Base title={`Things to do with kids in ${t.name}: ${items.length} activities & classes`} description={`Kids' activities in ${t.name}: ${items.length} local classes, clubs, holiday camps and days out, with ages, prices and timetables checked against each provider's own website.`} jsonLd={jsonLd} noindex={items.length < MIN_TO_INDEX_TOWN}>
  <div class="container">
    <ol class="crumbs" aria-label="Breadcrumb"><li><a href="/">Home</a></li><li aria-hidden="true">/</li><li><a href="/towns/">Towns</a></li><li aria-hidden="true">/</li><li aria-current="page">{t.name}</li></ol>
    <header class="page-head">
      <p class="plate">Stop: {t.name} — {items.length} {items.length === 1 ? 'listing' : 'listings'}</p>
      <h1>Kids’ activities in <em>{t.name}</em></h1>
      <p class="lead">{t.blurb}</p>
    </header>
    {catLinks.length > 0 && <nav class="pills" aria-label="By activity">{catLinks.map((c) => <a class="chip" href={`/towns/${town}/${c}/`}>{CATEGORIES[c].name}</a>)}</nav>}
    <Filters hideTown />
    <h2 class="sr-only">Listings</h2>
    <div class="cards" id="results">{items.map((l, i) => <ListingCard listing={l} index={i} />)}</div>
    <p class="empty" id="no-results" hidden>Nothing matches those filters. <a href="/list-your-activity/">Know one we’ve missed?</a></p>
    <div style="height:96px"></div>
  </div>
</Base>
