---
// Town x category landing pages, e.g. /towns/rickmansworth/swimming/. Only generated with enough listings.
import Base from '../../../layouts/Base.astro';
import ListingCard from '../../../components/ListingCard.astro';
import CategoryIcon from '../../../components/CategoryIcon.astro';
import { getListings, byTown, byCategory, MIN_FOR_COMBO_PAGE, type Listing } from '../../../lib/listings';
import { TOWNS, CATEGORIES, type TownKey, type CategoryKey } from '../../../data/taxonomy';

export async function getStaticPaths() {
  const listings = await getListings();
  const paths = [];
  for (const town of Object.keys(TOWNS) as TownKey[]) {
    for (const cat of Object.keys(CATEGORIES) as CategoryKey[]) {
      const items = byCategory(byTown(listings, town), cat);
      if (items.length >= MIN_FOR_COMBO_PAGE) paths.push({ params: { town, cat }, props: { town, cat, items } });
    }
  }
  return paths;
}
interface Props { town: TownKey; cat: CategoryKey; items: Listing[] }
const { town, cat, items } = Astro.props;
const t = TOWNS[town];
const c = CATEGORIES[cat];
const itemList = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  name: `${c.name} for kids in ${t.name}`,
  itemListElement: items.map((l, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://westhertskids.co.uk/activities/${l.id}/`, name: l.data.name })),
};
---
<Base title={`${c.name} for kids in ${t.name}`} description={`${items.length} ${c.name.toLowerCase()} options for children in ${t.name}, with ages, prices and timetables.`} jsonLd={itemList}>
  <div class="container">
    <ol class="crumbs" aria-label="Breadcrumb"><li><a href="/">Home</a></li><li aria-hidden="true">/</li><li><a href={`/towns/${town}/`}>{t.name}</a></li><li aria-hidden="true">/</li><li aria-current="page">{c.name}</li></ol>
    <header class="page-head" style="display:flex;gap:28px;align-items:center;flex-wrap:wrap">
      <CategoryIcon cat={cat} size={104} />
      <div style="flex:1;min-width:260px">
        <p class="plate">Stop: {t.name} — {items.length} options</p>
        <h1>{c.name} for kids in <em>{t.name}</em></h1>
        <p class="lead">{c.blurb} Here are {items.length} options in and around {t.name}.</p>
      </div>
    </header>
    <div class="cards" id="results" style="margin-top:32px">{items.map((l, i) => <ListingCard listing={l} index={i} />)}</div>
    <p class="muted" style="margin:32px 0 96px">Also see all <a href={`/category/${cat}/`}>{c.name.toLowerCase()} across West Herts</a>, or <a href={`/towns/${town}/`}>everything in {t.name}</a>.</p>
  </div>
</Base>
