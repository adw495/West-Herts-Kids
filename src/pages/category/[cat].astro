---
import Base from '../../layouts/Base.astro';
import ListingCard from '../../components/ListingCard.astro';
import Filters from '../../components/Filters.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import Glance from '../../components/Glance.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import { lc, getListings, byCategory, byTown, MIN_FOR_COMBO_PAGE, townCounts, breadcrumbLd, itemListLd, glance, type Listing } from '../../lib/listings';
import { CATEGORIES, TOWNS, CATEGORY_KEYS, type CategoryKey, type TownKey } from '../../data/taxonomy';

export async function getStaticPaths() {
  const listings = await getListings();
  return (Object.keys(CATEGORIES) as CategoryKey[])
    .map((cat) => ({ params: { cat }, props: { cat, items: byCategory(listings, cat) } }))
    .filter((p) => p.props.items.length > 0);
}
interface Props { cat: CategoryKey; items: Listing[] }
const { cat, items } = Astro.props;
const c = CATEGORIES[cat];
const figNo = String(CATEGORY_KEYS.indexOf(cat) + 1).padStart(2, '0');
const jsonLd = [
  itemListLd(`${c.name} for kids in West Herts`, items),
  breadcrumbLd([['Home', '/'], ['All activities', '/activities/'], [c.name, `/category/${cat}/`]]),
];
const g = glance(items);
const title = `${c.search} for kids in Watford, Rickmansworth & West Herts`;
const description = [`Compare ${items.length} options for ${c.q} across Watford, Rickmansworth, Croxley Green, Chorleywood and nearby`, `ages from ${g.youngest}`, g.priceFrom ? `prices from ${g.priceFrom}` : ''].filter(Boolean).join(', ') + '.';
const tc = townCounts(items).slice(0, 4).map(([t, n]) => `${n} in ${TOWNS[t].name}`);
const intro = `We list ${items.length} ${items.length === 1 ? 'option' : 'options'} for ${c.q} across West Herts${tc.length > 1 ? `, including ${tc.slice(0, -1).join(', ')} and ${tc[tc.length - 1]}` : ''}${g.priceFrom ? `, with prices from ${g.priceFrom}` : ''}. Ages, prices and times come from each provider’s own website.`;
const townLinks = (Object.keys(TOWNS) as TownKey[]).filter((t) => byTown(items, t).length >= MIN_FOR_COMBO_PAGE);
---
<Base title={title} description={description} jsonLd={jsonLd} ogImage={`/og/category-${cat}.png`}>
  <div class="container">
    <ol class="crumbs" aria-label="Breadcrumb"><li><a href="/">Home</a></li><li aria-hidden="true">/</li><li><a href="/activities/">All activities</a></li><li aria-hidden="true">/</li><li aria-current="page">{c.name}</li></ol>
    <header class="page-head" style="display:flex;gap:28px;align-items:center;flex-wrap:wrap">
      <CategoryIcon cat={cat} size={112} />
      <div style="flex:1;min-width:260px">
        <p class="plate">fig. {figNo} — {items.length} {items.length === 1 ? 'listing' : 'listings'}</p>
        <h1>{c.search} <em>for kids</em> in West Herts</h1>
        <p class="lead">{c.blurb}</p>
        <p class="intro">{intro}</p>
      </div>
    </header>
    {townLinks.length > 0 && (
      <nav class="pills" aria-label="By town">{townLinks.map((t) => <a class="chip" href={`/towns/${t}/${cat}/`}>{TOWNS[t].name}</a>)}</nav>
    )}
    <Filters hideCategory />
    <h2 class="sr-only">Listings</h2>
    <div class="cards" id="results">{items.map((l, i) => <ListingCard listing={l} index={i} />)}</div>
    <p class="empty" id="no-results" hidden>Nothing matches those filters. <a href="/list-your-activity/">Know one we’ve missed?</a></p>
    <Glance items={items} q={c.q} place="West Herts" />
    <RelatedGuides cat={cat} heading={`Guides to ${lc(c.name)} for kids`} n={5} />
    <div style="height:96px"></div>
  </div>
</Base>
