---
// "At a glance" facts and an FAQ for landing pages. All text comes from verified listing fields (see lib/listings.ts).
import { glance, faqs, formatDate, ageShort, priceFact, type Listing } from '../lib/listings';
interface Props { items: Listing[]; q: string; place: string }
const { items, q, place } = Astro.props;
const g = glance(items);
const qa = faqs(items, q, place);
---
<section class="glance" aria-labelledby="glance-title">
  <h2 id="glance-title">At a glance</h2>
  <dl class="glance-grid">
    <div><dt>Options</dt><dd>{g.count}</dd></div>
    <div><dt>Youngest start</dt><dd>{g.youngest}</dd></div>
    {g.priceFrom && <div><dt>Prices from</dt><dd>{g.priceFrom}</dd></div>}
    {g.days && <div><dt>Days</dt><dd>{g.days}</dd></div>}
    {g.trials > 0 && <div><dt>Free trials</dt><dd>{g.trials}</dd></div>}
    {g.send > 0 && <div><dt>SEND-friendly</dt><dd>{g.send}</dd></div>}
  </dl>
  {g.checked && <p class="small muted">Details last checked {formatDate(g.checked)}, against each provider’s own website.</p>}
</section>
{items.length >= 2 && (
<section class="compare" aria-labelledby="compare-title">
  <h2 id="compare-title">Compare {q} in {place}</h2>
  <div class="table-wrap" tabindex="0" role="region" aria-label="Comparison table (scrolls sideways on small screens)">
    <table>
      <thead><tr><th scope="col">Provider</th><th scope="col">Ages</th><th scope="col">From</th><th scope="col">Free trial</th><th scope="col">SEND-friendly</th><th scope="col">Last checked</th></tr></thead>
      <tbody>
        {items.map((l) => { const p = priceFact(l.data); return (
          <tr>
            <th scope="row"><a href={`/activities/${l.id}/`}>{l.data.name}</a></th>
            <td>{ageShort(l.data.ageMin, l.data.ageMax)}</td>
            <td>{p && p.label === 'From' ? `${p.value}${p.sub ? ' ' + p.sub.replace(', free trial', '') : ''}` : 'Ask'}</td>
            <td>{l.data.freeTrial ? 'Yes' : '–'}</td>
            <td>{l.data.send === 'yes' ? 'Yes' : '–'}</td>
            <td>{l.data.verified ? formatDate(l.data.verified) : '–'}</td>
          </tr>
        ); })}
      </tbody>
    </table>
  </div>
</section>
)}
<section class="faq" aria-labelledby="faq-title">
  <h2 id="faq-title">Questions parents ask about {q} in {place}</h2>
  {qa.map((x) => (<details><summary>{x.q}</summary><p>{x.a}</p></details>))}
</section>
