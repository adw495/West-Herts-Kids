---
// Client-side filtering over the cards in #results. Values can come from the URL (e.g. from the homepage search),
// so filtered views can be shared: ?q=ballet&town=watford&age=0-4&season=holidays&send=on&trial=on
import { TOWNS, CATEGORIES } from '../data/taxonomy';
interface Props { hideTown?: boolean; hideCategory?: boolean }
const { hideTown = false, hideCategory = false } = Astro.props;
---
<form class="filters" id="filters" role="search" onsubmit="return false">
  <div class="field"><label for="f-q">Search</label><input class="input" id="f-q" type="search" name="q" placeholder="e.g. ballet, swimming" /></div>
  {!hideCategory && (
    <div class="field"><label for="f-cat">Activity</label>
      <select class="select" id="f-cat" name="cat"><option value="">All activities</option>
        {Object.entries(CATEGORIES).map(([k, c]) => <option value={k}>{c.name}</option>)}
      </select></div>
  )}
  {!hideTown && (
    <div class="field"><label for="f-town">Town</label>
      <select class="select" id="f-town" name="town"><option value="">Any town</option>
        {Object.entries(TOWNS).map(([k, t]) => <option value={k}>{t.name}</option>)}
      </select></div>
  )}
  <div class="field"><label for="f-age">Age</label>
    <select class="select" id="f-age" name="age">
      <option value="">Any age</option>
      <option value="0-4">Under 5s</option>
      <option value="5-11">5 to 11</option>
      <option value="12-18">12 to 18</option>
      <option disabled>──────</option>
      <option value="0-0">Babies (under 1)</option>
      {Array.from({ length: 16 }, (_, i) => i + 1).map((n) => <option value={`${n}-${n}`}>{n} {n === 1 ? 'year' : 'years'}</option>)}
    </select></div>
  <div class="field"><label for="f-season">When</label>
    <select class="select" id="f-season" name="season"><option value="">Any time</option>
      <option value="term-time">Term time</option>
      <option value="holidays">School holidays</option>
    </select></div>
  <label class="check"><input type="checkbox" name="send" /> SEND-friendly</label>
  <label class="check"><input type="checkbox" name="trial" /> Free taster</label>
</form>
<p class="result-count" id="count" aria-live="polite"></p>

<script>
  const form = document.getElementById('filters') as HTMLFormElement | null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#results .fcard'));
  const count = document.getElementById('count');
  const empty = document.getElementById('no-results');

  function ageRange(v: string): [number, number] | null {
    if (!v) return null;
    const m = v.match(/^(\d+)(?:-(\d+))?$/);
    if (!m) return null;
    const a = Number(m[1]);
    return [a, m[2] ? Number(m[2]) : a];
  }

  function apply() {
    if (!form) return;
    const f = new FormData(form);
    const q = String(f.get('q') ?? '').trim().toLowerCase();
    const cat = String(f.get('cat') ?? '');
    const town = String(f.get('town') ?? '');
    const age = ageRange(String(f.get('age') ?? ''));
    const season = String(f.get('season') ?? '');
    const send = f.get('send') === 'on';
    const trial = f.get('trial') === 'on';
    let shown = 0;
    for (const c of cards) {
      const d = c.dataset;
      const ok =
        (!q || q.split(/\s+/).every((w) => (d.text ?? '').includes(w))) &&
        (!cat || (d.cats ?? '').split(' ').includes(cat)) &&
        (!town || (d.towns ?? '').split(' ').includes(town)) &&
        (!age || (Number(d.agemin) <= age[1] && Number(d.agemax) >= age[0])) &&
        (!season || (d.season ?? '').includes(season) || (d.season ?? '').includes('year-round')) &&
        (!send || d.send === 'yes') &&
        (!trial || d.trial === '1');
      c.hidden = !ok;
      if (ok) shown++;
    }
    if (count) count.textContent = `${shown} ${shown === 1 ? 'activity' : 'activities'}`;
    if (empty) empty.hidden = shown !== 0;
    const params = new URLSearchParams();
    for (const [k, v] of f.entries()) if (v) params.set(k, String(v));
    history.replaceState(null, '', params.toString() ? `?${params}` : location.pathname);
  }

  if (form) {
    const params = new URLSearchParams(location.search);
    for (const [k, v] of params) {
      const el = form.elements.namedItem(k) as HTMLInputElement | HTMLSelectElement | null;
      if (!el) continue;
      if (el instanceof HTMLInputElement && el.type === 'checkbox') el.checked = v === 'on' || v === '1';
      else el.value = v;
    }
    form.addEventListener('input', apply);
    apply();
  }
</script>
