---
// Newsletter sign-up form. Posts to the Cloudflare Pages Function at /api/subscribe (functions/api/subscribe.js),
// which forwards the email to beehiiv. Works without JavaScript; with JavaScript it submits in place.
import { SITE } from '../site.config';
interface Props { source?: string; compact?: boolean }
const { source = 'newsletter-page', compact = false } = Astro.props;
const id = `nl-${source}`;
---
<form class:list={['nl-form', { compact }]} action={SITE.forms.newsletterAction} method="post" data-newsletter>
  <input type="hidden" name="source" value={source} />
  <div class="nl-hp" aria-hidden="true">
    <label>Leave this empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>
  <label for={id} class={compact ? 'sr-only' : 'nl-label'}>Your email</label>
  <div class="nl-row">
    <input id={id} type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
    <button class="btn" type="submit">Sign me up</button>
  </div>
  <p class="nl-msg small" role="status" aria-live="polite"></p>
  {!compact && (
    <p class="small muted">Free, every Thursday. Unsubscribe any time. We only use your email to send the newsletter. See our <a href="/privacy/">privacy notice</a>.</p>
  )}
</form>

<style>
  .nl-form { display: grid; gap: 8px; max-width: 520px; }
  .nl-label { font-weight: 700; font-size: 0.9rem; }
  .nl-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .nl-row input { flex: 1 1 220px; min-width: 0; font: inherit; padding: 11px 14px; border-radius: 999px; border: 1px solid var(--line); background: #fff; }
  .nl-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .nl-msg:empty { display: none; }
  .nl-msg.ok { color: var(--brand); font-weight: 700; }
  .nl-msg.err { color: #9a3412; font-weight: 700; }
</style>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-newsletter]')) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = form.querySelector<HTMLElement>('.nl-msg');
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
      if (btn) btn.disabled = true;
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
        const data = await res.json().catch(() => ({ ok: false, message: 'Something went wrong. Please try again.' }));
        if (msg) { msg.textContent = data.message; msg.className = `nl-msg small ${data.ok ? 'ok' : 'err'}`; }
        if (data.ok) form.reset();
      } catch {
        if (msg) { msg.textContent = 'Could not connect. Please check your internet and try again.'; msg.className = 'nl-msg small err'; }
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  }
</script>
