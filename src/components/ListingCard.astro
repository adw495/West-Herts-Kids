---
import { ageLabel, priceLabel, townNames, isFeaturedNow, type Listing } from '../lib/listings';
import { CATEGORIES } from '../data/taxonomy';

interface Props { listing: Listing }
const { listing } = Astro.props;
const d = listing.data;
const featured = isFeaturedNow(listing);
const price = priceLabel(d);
---
<article
  class:list={['card', { featured }]}
  data-towns={d.towns.join(' ')}
  data-cats={d.categories.join(' ')}
  data-agemin={d.ageMin}
  data-agemax={d.ageMax}
  data-season={d.season.join(' ')}
  data-send={d.send}
  data-text={`${d.name} ${d.summary} ${d.venue.name ?? ''}`.toLowerCase()}
>
  <div class="meta">
    {featured && <span class="pill gold">★ Featured</span>}
    <span class="pill">{CATEGORIES[d.categories[0]].emoji} {CATEGORIES[d.categories[0]].name}</span>
    <span class="pill age">Ages {ageLabel(d.ageMin, d.ageMax)}</span>
  </div>
  <h3><a href={`/activities/${listing.id}/`}>{d.name}</a></h3>
  <p>{d.summary}</p>
  <div class="meta small">
    <span class="muted">📍 {townNames(d.towns).join(', ')}</span>
    {price && <span class="muted">· {price}</span>}
    {d.send === 'yes' && <span class="pill grey">SEND-friendly</span>}
    {d.season.includes('holidays') && <span class="pill grey">Holidays</span>}
  </div>
</article>
